{
  "id": "ts-notes",
  "kind": "tool",
  "api": 1,
  "version": "0.1.0",
  "displayName": "Notes (TypeScript example)",
  "description": "Example plugin written with the TypeScript SDK: keeps notes and reports each addition as an event.",
  "runtime": { "exec": "node", "args": ["dist/main.js"], "dev": { "args": ["src/main.ts"] } },
  "level": 4,
  "tools": ["tsn_add", "tsn_list", "tsn_wait"],
  "envPrompt": "./ENV_PROMPT.md"
}
