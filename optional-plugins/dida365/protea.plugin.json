{
  "id": "dida365",
  "kind": "source",
  "api": 1,
  "version": "0.1.0",
  "displayName": "Dida365 (滴答清单)",
  "description": "The owner's Dida365 / TickTick account through the official Open API: tasks, projects, tags, comments, focus records, habits and countdowns as tools, and optional events when a task reaches its time.",
  "runtime": { "exec": "node", "args": ["dist/main.js"], "dev": { "args": ["src/main.ts"] } },
  "level": 2,
  "triggers": ["flush", "debounce", "piggyback"],
  "tools": [
    "dida_status",
    "dida_task_undone",
    "dida_task_filter",
    "dida_task_search",
    "dida_task_completed",
    "dida_task_get",
    "dida_task_create",
    "dida_task_update",
    "dida_task_complete",
    "dida_task_move",
    "dida_task_batch",
    "dida_task_assign",
    "dida_comment_add",
    "dida_project_list",
    "dida_project_get",
    "dida_project_save",
    "dida_group_save",
    "dida_column_save",
    "dida_tag_list",
    "dida_tag_create",
    "dida_focus_list",
    "dida_focus_create",
    "dida_habit_list",
    "dida_habit_save",
    "dida_habit_checkin",
    "dida_countdown_list",
    "dida_delete"
  ],
  "sideEffectTools": [
    "dida_task_create",
    "dida_task_update",
    "dida_task_complete",
    "dida_task_move",
    "dida_task_batch",
    "dida_task_assign",
    "dida_comment_add",
    "dida_project_save",
    "dida_group_save",
    "dida_column_save",
    "dida_tag_create",
    "dida_focus_create",
    "dida_habit_save",
    "dida_habit_checkin",
    "dida_delete"
  ],
  "secrets": ["DIDA365_TOKEN"],
  "configSchema": "./config.schema.json",
  "envPrompt": "./ENV_PROMPT.md",
  "homepage": "https://developer.dida365.com/docs#/openapi"
}
