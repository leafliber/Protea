{
  "name": "protea",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "24/7 event-stream personal assistant harness",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "PROTEA_DATA_DIR=.dev-data tsx apps/cli/src/main.ts serve",
    "protea": "tsx apps/cli/src/main.ts",
    "clean": "rm -rf packages/*/dist plugins/*/dist apps/*/dist"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
