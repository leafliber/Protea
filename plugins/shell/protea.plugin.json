{
  "id": "shell",
  "kind": "tool",
  "api": 1,
  "version": "0.1.0",
  "displayName": "Shell",
  "description": "Runs shell commands in the data volume's workspace (/data/workspace), with a timeout, an output cap and no secrets in the environment.",
  "runtime": { "exec": "node", "args": ["dist/main.js"], "dev": { "args": ["src/main.ts"] } },
  "level": 4,
  "tools": ["sh_run"],
  "sideEffectTools": ["sh_run"],
  "configSchema": "./config.schema.json",
  "envPrompt": "./ENV_PROMPT.md"
}
