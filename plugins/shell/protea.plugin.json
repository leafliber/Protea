{
  "id": "shell",
  "kind": "tool",
  "api": 1,
  "version": "0.1.0",
  "displayName": "Shell",
  "description": "Shell commands for the assistant: in the separate sandbox container (state carried between commands, background jobs), or without isolation in the daemon's container (backend: local).",
  "runtime": {
    "exec": "node",
    "args": [
      "dist/main.js"
    ],
    "dev": {
      "args": [
        "src/main.ts"
      ]
    }
  },
  "level": 3,
  "tools": [
    "sh_run",
    "sh_job_start",
    "sh_job_list",
    "sh_job_logs",
    "sh_job_stop",
    "sh_reset"
  ],
  "sideEffectTools": [
    "sh_run",
    "sh_job_start",
    "sh_job_stop",
    "sh_reset"
  ],
  "configSchema": "./config.schema.json",
  "envPrompt": "./ENV_PROMPT.md",
  "triggers": [
    "piggyback",
    "flush"
  ]
}
