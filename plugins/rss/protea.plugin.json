{
  "id": "rss",
  "kind": "source",
  "api": 1,
  "version": "0.1.0",
  "displayName": "RSS / Atom feeds",
  "description": "Polls RSS and Atom feeds and reports new items, one event per item (deduplicated).",
  "runtime": { "exec": "node", "args": ["dist/main.js"], "dev": { "args": ["src/main.ts"] } },
  "level": 3,
  "triggers": ["debounce", "piggyback", "store"],
  "tools": ["rss_feeds", "rss_items"],
  "configSchema": "./config.schema.json",
  "envPrompt": "./ENV_PROMPT.md"
}
