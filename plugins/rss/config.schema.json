{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "feeds": {
      "type": "array",
      "description": "Feeds to poll.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$", "description": "Short name; default derived from the host." },
          "intervalMin": { "type": "number", "minimum": 1 },
          "level": { "enum": [3, 4] }
        }
      }
    },
    "intervalMin": { "type": "number", "minimum": 1, "default": 30, "description": "Default polling interval." },
    "level": { "enum": [3, 4], "default": 4, "description": "4: items ride along with other events; 3: they get a debounced batch of their own." },
    "firstRunItems": { "type": "integer", "minimum": 0, "maximum": 20, "default": 3, "description": "On a feed's first poll, report this many newest items; the rest are marked seen." },
    "maxItemsPerPoll": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 },
    "timeoutSec": { "type": "number", "minimum": 1, "default": 20 }
  }
}
